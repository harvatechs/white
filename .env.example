# ==============================================================================
# WHITE Search — Environment Configuration
# ==============================================================================
# WHITE Search works 100% out of the box with zero API keys required!
# Copy this file to .env and adjust variables as needed.

# ------------------------------------------------------------------------------
# 1. Database (SQLite)
# ------------------------------------------------------------------------------
# Relative path to SQLite database file.
DATABASE_URL="file:../db/custom.db"

# ------------------------------------------------------------------------------
# 2. Search Provider Configuration
# ------------------------------------------------------------------------------
# Default provider for web search: 'ddg' (DuckDuckGo), 'searxng', 'local'
# Default: 'ddg'
DEFAULT_SEARCH_PROVIDER="ddg"

# Preferred SearXNG instance (used when provider is 'searxng' or for image search)
# Default: 'https://searx.be'
SEARXNG_INSTANCE="https://searx.be"

# ------------------------------------------------------------------------------
# 3. Optional AI / LLM Configuration (For Reading Mode Summaries)
# ------------------------------------------------------------------------------
# WHITE Search includes built-in offline extractive summarization and Markov models.
# To optionally enable generative LLM summaries, configure any OpenAI-compatible API:
# (Supports OpenAI, Groq, Mistral, DeepSeek, Ollama, vLLM, LM Studio)

# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# Example: Local Ollama setup
# OPENAI_API_KEY="ollama"
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_MODEL="llama3.2"

# ------------------------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="production"
